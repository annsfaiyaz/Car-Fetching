# --- Auth (register / login / admin)
# JWT_SECRET=change-me-in-production
# JWT_EXPIRE_HOURS=168
# First user with this email gets admin role on register and on startup (if already exists)
# ADMIN_EMAIL=you@example.com

# Optional: override default SQLite file (default: backend/data/car_listings.db)
# SQLITE_DATABASE_URL=sqlite+aiosqlite:///./data/car_listings.db

# Max listing age for scrapers (hours). Listings older than this are skipped. Default 48 (2 days).
# Overrides SQLite scrape.max_age_hours when set (see scraper resolution order in code).
# SCRAPE_MAX_LISTING_AGE_HOURS=48
#
# Legacy alias (used if SCRAPE_MAX_LISTING_AGE_HOURS is unset):
# PAKWHEELS_MAX_AGE_HOURS=48

# Stop after this many search pages (default 3)
# PAKWHEELS_MAX_PAGES=3

# Stop after collecting this many listings (default 50)
# PAKWHEELS_MAX_LISTINGS=50

# Dashboard WebSocket scrape (/api/pakwheels/ws/scrape) — max listings per streamed run (default 25)
# PAKWHEELS_STREAM_MAX_LISTINGS=25

# OLX Playwright: extra wait (ms) after network idle for React to paint listing cards (default 6500)
# OLX_RENDER_WAIT_MS=6500

# OLX scrape limits when not overridden by SQLite settings / request (defaults: pages 3, listings 25)
# OLX_MAX_PAGES=3
# OLX_MAX_LISTINGS=25

# SQLite keys scrape.max_pages, scrape.max_listings, scrape.max_age_hours — editable on /settings
#
# RSS news feeds: JSON list URL stored as SQLite key news.rss_urls (see GET /api/settings).
# Background job poll_news_feeds runs every hour while the API process is up.

# --- Ollama (optional): AI → PakWheels search URL via POST /api/pakwheels/suggest-url
# Install: https://ollama.com/download — then: ollama pull llama3.2
# Recommended models: llama3.2 (fast 3B, default), or llama3.1:8b / mistral for higher quality.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2
# OLLAMA_TIMEOUT_SEC=120

# Chat widget (POST /api/pakwheels/chat) — optional overrides
# OLLAMA_CHAT_MODEL=llama3.2
# OLLAMA_CHAT_TIMEOUT_SEC=120
# OLLAMA_CHAT_MAX_LISTINGS=100
# OLLAMA_CHAT_MAX_CHARS=28000
# OLLAMA_CHAT_DESC_CHARS=280
